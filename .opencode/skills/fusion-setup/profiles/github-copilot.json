{
  "$schema": "https://opencode.ai/config.json",
  "subagent_depth": 2,
  "model": "github-copilot/claude-sonnet-5",
  "small_model": "github-copilot/gpt-5.6-luna",
  "provider": {
    "github-copilot": {
      "models": {
        "claude-sonnet-5": { "name": "Claude Sonnet 5" },
        "gpt-5.6-luna": { "name": "GPT-5.6 Luna" },
        "gemini-3.5-flash": { "name": "Gemini 3.5 Flash" },
        "gpt-5.6-sol": { "name": "GPT-5.6 Sol" }
      }
    }
  },
  "agent": {
    "build": { "model": "github-copilot/claude-sonnet-5" },
    "sidekick": { "model": "github-copilot/gpt-5.6-luna" },
    "explore": { "model": "github-copilot/gpt-5.6-luna" },
    "research": { "model": "github-copilot/gemini-3.5-flash" },
    "reviewer": { "model": "github-copilot/gpt-5.6-sol" }
  }
}
